# Option A (free, local): install Ollama, then `ollama pull llama3.2`
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# Option B (OpenAI API): uncomment and fill in
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
